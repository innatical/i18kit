{
  "name": "i18kit",
  "version": "0.1.0",
  "description": "CLI for managing i18n translations",
  "type": "module",
  "bin": {
    "i18kit": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": ["dist"],
  "scripts": {
    "build:ui": "bun run --cwd ../web build",
    "build": "bun run build:ui && bun build src/index.tsx --outdir dist --target node --external @swc/core --external ink --external react --external ink-spinner --external ink-text-input --minify && rm -rf dist/ui && cp -R ../web/dist dist/ui",
    "dev": "bun run src/index.tsx",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@i18kit/core": "workspace:*",
    "@swc/core": "1.15.33",
    "gettext-parser": "9.0.2",
    "ink": "7.0.2",
    "ink-spinner": "5.0.0",
    "ink-text-input": "6.0.0",
    "react": "19.2.6"
  },
  "devDependencies": {
    "@types/bun": "1.3.13",
    "@types/gettext-parser": "^9.0.0",
    "@types/react": "19.2.14"
  },
  "engines": {
    "bun": ">=1"
  },
  "keywords": ["i18n", "translations", "cli"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/innatical/i18kit.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
