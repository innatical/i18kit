{
  "name": "i18kit",
  "version": "0.1.0",
  "description": "CLI for managing i18n translations",
  "type": "module",
  "bin": {
    "i18kit": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": ["dist"],
  "scripts": {
    "build": "bun build src/index.tsx --outdir dist --target bun --external @swc/core --minify",
    "dev": "bun run src/index.tsx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@i18kit/core": "workspace:*",
    "@swc/core": "1.15.33",
    "gettext-parser": "9.0.2",
    "ink": "7.0.2",
    "ink-spinner": "5.0.0",
    "ink-text-input": "6.0.0",
    "react": "19.2.6"
  },
  "devDependencies": {
    "@types/bun": "1.3.13",
    "@types/gettext-parser": "^9.0.0",
    "@types/react": "19.2.14"
  },
  "engines": {
    "bun": ">=1"
  },
  "keywords": ["i18n", "translations", "cli"],
  "license": "MIT"
}
