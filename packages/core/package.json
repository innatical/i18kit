{
  "name": "@i18kit/core",
  "version": "0.1.0",
  "description": "Runtime translation library — t(), tc(), createTranslator()",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target node --external gettext-parser && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "gettext-parser": "9.0.2"
  },
  "devDependencies": {
    "@types/bun": "1.3.13",
    "@types/gettext-parser": "9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/innatical/i18kit.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
